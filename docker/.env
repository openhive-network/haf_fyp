# HAF base image — pin to a specific tag before connecting to mainnet
HAF_REGISTRY=registry.gitlab.syncad.com/hive
# Not `latest`: hive/haf:latest was last pushed 2026-01-14 and predates the
# application registry (hive.app_register, haf#341) that db/register_app.sql
# and the block-processing driver need. A registry-era develop image instead.
HAF_VERSION=d26f14cc

# haf_fyp SQL image (setup + sync services)
HAF_FYP_SQL_REGISTRY=registry.gitlab.syncad.com/hive
HAF_FYP_SQL_VERSION=latest

# haf_fyp Python image (ranker + api services)
HAF_FYP_PYTHON_REGISTRY=registry.gitlab.syncad.com/hive
HAF_FYP_PYTHON_VERSION=latest

# haf_fyp rewriter image (public read API). CI publishes `postgrest-rewriter`, tagged
# with the short SHA and the branch name -- there is no `latest`, so pinning that would
# never resolve. Set HAF_FYP_REWRITER_VERSION to a short SHA to pin a specific build.
HAF_FYP_REWRITER_REGISTRY=registry.gitlab.syncad.com/hive
HAF_FYP_REWRITER_VERSION=develop

# PostgREST
POSTGREST_VERSION=v12.2.3

# Volume names (#53). Unset, they follow the project: haf_fyp_haf_datadir and
# haf_fyp_redis_data (<p>_haf_datadir under -p <p>). Never set them in THIS file -- it is
# tracked, and would pin every checkout's names. A stack started before #53 without -p or
# COMPOSE_PROJECT_NAME ran under the project `docker`; to keep its HAF data,
# scripts/upgrade_standalone_stack.sh sets this in .env.local instead:
# HAF_FYP_HAF_DATADIR_VOLUME=docker_haf_datadir

# Ports exposed on host.
#
# API_PORT is the PUBLIC read API and belongs to the rewriter
# (haf-fyp-postgrest-rewriter), which
# serves the documented /v1/fyp/... paths. POSTGREST_HOST_PORT publishes PostgREST's raw
# /rpc/ surface for debugging; the rewriter cannot serve it, because its generated
# catch-all would turn /rpc/get_health into /rpc/rpc/get_health.
#
# This file is TRACKED and compose auto-loads it, so a value set here OVERRIDES the
# ${VAR:-default} in docker-compose.yml. Changing a port means changing it here, not
# only there -- and `docker compose config` performs NO host-port uniqueness check, so
# two services bound to the same port validate cleanly and fail only at `up`.
# tests/unit/test_compose_contract.py is what catches that.
API_PORT=3001
POSTGREST_HOST_PORT=3000
FYP_API_PORT=3002

# Algorithm governance — set a strong random value before exposing to the internet
# Used by POST /v1/fyp/admin/algorithm (X-Admin-Key header)
FYP_ADMIN_API_KEY=changeme-before-production

# Address (or CIDR, comma-separated) of whatever fronts this app -- Caddy, Varnish,
# HAProxy. Rate limits key on X-Real-IP only from a peer on this list; from anyone
# else the header is ignored and every caller shares the peer's bucket.
#
# LEAVING THIS EMPTY DISABLES pre-validation rate limiting (#28), because charging a
# request before it is validated is only safe when the bucket identifies the caller
# -- into a shared bucket it lets one sender 429 everybody else.
#
# Set it to the edge's address/CIDR, or to the literal `direct` if nothing fronts
# this app and the socket peer really is the client.
TRUSTED_PROXY_IPS=

# TRUSTED Hive RPC used to verify interest-write signatures (POST /v1/fyp/interests).
# MUST be a node you trust — the auth guarantee depends on it returning the real
# on-chain posting keys; a hostile node can forge them and bypass auth. Use the
# local hived, never a shared/public API. If unset, interest writes fail closed (503).
HIVE_RPC_URL=http://haf:8091
