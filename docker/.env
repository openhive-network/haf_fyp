# HAF base image — pin to a specific tag before connecting to mainnet
HAF_REGISTRY=registry.gitlab.syncad.com/hive
HAF_VERSION=latest

# haf_fyp SQL image (setup + sync services)
HAF_FYP_SQL_REGISTRY=registry.gitlab.syncad.com/hive
HAF_FYP_SQL_VERSION=latest

# haf_fyp Python image (ranker + api services)
HAF_FYP_PYTHON_REGISTRY=registry.gitlab.syncad.com/hive
HAF_FYP_PYTHON_VERSION=latest

# PostgREST
POSTGREST_VERSION=v12.2.3

# Ports exposed on host
API_PORT=3001
FYP_API_PORT=3002

# Algorithm governance — set a strong random value before exposing to the internet
# Used by POST /v1/fyp/admin/algorithm (X-Admin-Key header)
FYP_ADMIN_API_KEY=changeme-before-production
