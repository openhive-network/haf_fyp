# HAF base image — pin to a specific tag before connecting to mainnet
HAF_REGISTRY=registry.gitlab.syncad.com/hive
# Not `latest`: it MOVES, so it is not a pin. It is a pointer with no history
# -- today it shares its digest with the develop build f7edd618, while the
# registry still reports it as created 2026-01-14 -- so two hosts pulling a
# week apart can run different HAF and nothing here records which.
#
# 1.29.0-rc2 is the OLDEST release tag carrying the application registry
# (hive.app_register, haf#341) that db/register_app.sql and the
# block-processing driver use: src/hive_fork_manager/app_registry.sql exists
# at 1.29.0-rc2 and on develop, and at no earlier tag (1.29.0-rc1, 1.28.7,
# 1.28.6 lack it).
#
# Not a commit tag either (#56). The project's cleanup policy keeps `1\..+`
# (every release and candidate) indefinitely, and keeps anything else only
# while it is one of the 5 newest or younger than 7 days -- so a SHA's life
# depends on how busy haf's develop is, which is nothing this repo controls.
# d26f14cc lasted about three weeks: pushed 2026-08-28, pinned here on
# 2026-09-15, still resolving on 2026-09-17, and swept by 2026-09-20 once it
# fell out of the newest five. A SHA here rots into a `manifest unknown` on
# the next pull, and no test can see it coming.
#
# CHANGING THIS AFTER HAF HAS SYNCED IS NOT AN UPGRADE -- IT IS A REPLAY.
# HAF 1.29.0 added hafd.transactions.rc_cost and deliberately ships no
# migration for it ("the values cannot be backfilled without a replay", its
# update-script generator), so its entrypoint compares schema hashes, exits 1,
# and `restart: unless-stopped` turns that into a crash loop while every
# dependent service waits on a HAF that never reports healthy. Pin once, before
# the first sync. To move afterwards: stop the stack, put the HAF volume aside
# (see scripts/upgrade_standalone_stack.sh for the naming), and let the new
# version replay into a fresh one.
#
# HAF_VERSION is also the key haf_api_node's haf_base.yaml reads, and a shell
# variable beats any --env-file. Never `export` it in a shell you also run a
# node's compose commands from: there it would recreate the NODE's HAF.
#
# That this tag still EXISTS is no longer taken on trust: the scheduled
# registry-resolution lane resolves it against the real registry (#71), along with
# every image the compose files PULL and every Dockerfile's FROM. Nothing else
# does -- compose-validate never contacts a registry. See README, "Checking that
# the pinned images still exist".
#
# NOT covered, and worth knowing: the HAF_FYP_SQL_* and HAF_FYP_PYTHON_* keys
# below. No file in this repository references them -- they exist for
# haf_api_node's module file -- so nothing here can resolve them into an image
# reference to check.
HAF_VERSION=1.29.0-rc2

# haf_fyp SQL image (setup + sync services)
HAF_FYP_SQL_REGISTRY=registry.gitlab.syncad.com/hive
HAF_FYP_SQL_VERSION=latest

# haf_fyp Python image (ranker + api services)
HAF_FYP_PYTHON_REGISTRY=registry.gitlab.syncad.com/hive
HAF_FYP_PYTHON_VERSION=latest

# haf_fyp rewriter image (public read API). CI publishes `postgrest-rewriter`, tagged
# with the short SHA and the branch name -- there is no `latest`, so pinning that would
# never resolve. Set HAF_FYP_REWRITER_VERSION to a short SHA to pin a specific build.
HAF_FYP_REWRITER_REGISTRY=registry.gitlab.syncad.com/hive
HAF_FYP_REWRITER_VERSION=develop

# PostgREST
POSTGREST_VERSION=v12.2.3

# Ranker tuning (README, "How fresh a feed is"). Each is passed to haf-fyp-ranker when
# it is set, and the ranker uses its own default when it is not. The values shown are
# those defaults. To change one, uncomment it in YOUR copy (.env.local), not in this
# tracked file, then recreate the ranker with the same --env-file as everything else:
#
#   docker compose --env-file docker/.env.local -f docker/docker-compose.yml \
#     up -d --build --no-deps haf-fyp-ranker
#
# A variable of the same name exported in your shell outranks the file.
#
# MAX_USERS_PER_CYCLE is the one to look at on a node with a large rotation: a full
# rotation takes (accounts in haf_fyp_app.active_users / MAX_USERS_PER_CYCLE) cycles,
# each its ranking time plus a five-minute wait. On a full node with 45,000 accounts
# that was about 22 hours at 200 and under 4 hours at 3000.
#
# MAX_USERS_PER_CYCLE=200
# READER_CYCLE_SHARE=0.5
# READER_WINDOW_SECONDS=86400
# READ_REFRESH_MIN_AGE_SECONDS=600
# READ_REFRESH_BATCH_SECONDS=30
# READ_REFRESH_MAX_PER_CYCLE has no fixed default: MAX_USERS_PER_CYCLE x
# READER_CYCLE_SHARE, at most 300. Set a number to override it.
# READ_REFRESH_MAX_PER_CYCLE=

# Volume names (#53). Unset, they follow the project: haf_fyp_haf_datadir and
# haf_fyp_redis_data (<p>_haf_datadir under -p <p>). Never set them in THIS file -- it is
# tracked, and would pin every checkout's names. A stack started before #53 without -p or
# COMPOSE_PROJECT_NAME ran under the project `docker`; to keep its HAF data,
# scripts/upgrade_standalone_stack.sh sets this in .env.local instead:
# HAF_FYP_HAF_DATADIR_VOLUME=docker_haf_datadir

# Ports exposed on host.
#
# API_PORT is the PUBLIC read API and belongs to the rewriter
# (haf-fyp-postgrest-rewriter), which
# serves the documented /v1/fyp/... paths. POSTGREST_HOST_PORT publishes PostgREST's raw
# /rpc/ surface for debugging; the rewriter cannot serve it, because its generated
# catch-all would turn /rpc/get_health into /rpc/rpc/get_health.
#
# This file is TRACKED and compose auto-loads it, so a value set here OVERRIDES the
# ${VAR:-default} in docker-compose.yml. Changing a port means changing it here, not
# only there -- and `docker compose config` performs NO host-port uniqueness check, so
# two services bound to the same port validate cleanly and fail only at `up`.
# tests/unit/test_compose_contract.py is what catches that.
API_PORT=3001
POSTGREST_HOST_PORT=3000
FYP_API_PORT=3002

# Base URL the published OpenAPI document advertises in `servers` (#58). Leave unset
# for a stack reached at the root of the rewriter's port. Behind a proxy that serves
# this stack under a prefix, set it to that prefix (e.g. /haf-fyp-api) or to the full
# public URL with a path. haf-fyp-setup applies it on every `up`.
# FYP_SWAGGER_URL=/

# Algorithm governance — set a strong random value before exposing to the internet
# Used by POST /v1/fyp/admin/algorithm (X-Admin-Key header)
FYP_ADMIN_API_KEY=changeme-before-production

# Address (or CIDR, comma-separated) of whatever fronts this app -- Caddy, Varnish,
# HAProxy. Rate limits key on X-Real-IP only from a peer on this list; from anyone
# else the header is ignored and every caller shares the peer's bucket.
#
# LEAVING THIS EMPTY DISABLES pre-validation rate limiting (#28), because charging a
# request before it is validated is only safe when the bucket identifies the caller
# -- into a shared bucket it lets one sender 429 everybody else.
#
# Set it to the edge's address/CIDR, or to the literal `direct` if nothing fronts
# this app and the socket peer really is the client.
#
# X-Real-IP must also ARRIVE: set by the outermost proxy (Caddy: `header_up
# X-Real-IP {client_ip}`) and passed on by any in between. Requests from a listed
# peer without it are treated as if the list were empty, and the app logs one
# warning naming the peer they came from (#35).
TRUSTED_PROXY_IPS=

# TRUSTED Hive RPC used to verify interest-write signatures (POST /v1/fyp/interests).
# MUST be a node you trust — the auth guarantee depends on it returning the real
# on-chain posting keys; a hostile node can forge them and bypass auth. Use the
# local hived, never a shared/public API. If unset, interest writes fail closed (503).
HIVE_RPC_URL=http://haf:8091
